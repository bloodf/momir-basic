{
  "expo": {
    // NOTE: Thermal printer and Bluetooth features (react-native-thermal-pos-printer)
    // require custom dev builds via expo-dev-client. These features will NOT work in Expo Go.
    // Use `bun run start --dev-client` to run with a development build.
    "name": "Momir Basic",
    "slug": "khur2ml36fu56vvhu6tre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.khur2ml36fu56vvhu6tre",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to thermal POS printers for printing receipts and orders.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to connect to thermal POS printers for printing receipts and orders."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.khur2ml36fu56vvhu6tre",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}